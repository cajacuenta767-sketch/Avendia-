# ==============================================================================
# AVEND ESCALA — PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================

# Conexión a Base de Datos PostgreSQL (Neon / Supabase / VPS)
DATABASE_URL="postgresql://usuario:password@host:5432/avend_escala?sslmode=require"
DIRECT_URL="postgresql://usuario:password@host:5432/avend_escala?sslmode=require"

# URLs base de la aplicación
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Credenciales de Administrador
ADMIN_PRIMARY_IDENTIFIERS="admin@example.com,admin"
ADMIN_PRIMARY_PASSWORD="change_me_in_production"
ADMIN_SECONDARY_IDENTIFIERS="superadmin@example.com,superadmin"
ADMIN_SECONDARY_PASSWORD="change_me_in_production"

# Claves de Seguridad y PINs
DOCENTE_PIN_SECRET="docente_pin_secret_key"
NEXTAUTH_SECRET="nextauth_secret_key"

# Cloudflare R2 (Almacenamiento de Cuadernillos y Recursos)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="your_r2_bucket_name"
R2_PUBLIC_DOMAIN="https://pub-xxxx.r2.dev"
